SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=django.db.backends.mysql
DB_NAME=employeehub
DB_USER=avnadmin
DB_PASSWORD=replace-with-aiven-password
DB_HOST=your-aiven-host.aivencloud.com
