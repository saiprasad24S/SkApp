{
  "expo": {
    "name": "Skandan Portal",
    "slug": "skandan-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "skandan-portal",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B2FA0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skandan.portal",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is required for face verification during attendance",
        "NSLocationWhenInUseUsageDescription": "Location is required for attendance geofence verification",
        "NSLocationAlwaysUsageDescription": "Background location is used during active duty sessions",
        "NSFaceIDUsageDescription": "Face ID is used for secure authentication"
      }
    },
    "android": {
      "package": "com.skandan.portal",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera is required for attendance verification selfies"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Location is used for attendance geofence verification and duty tracking",
          "locationAlwaysPermission": "Background location is used during active duty sessions",
          "locationWhenInUsePermission": "Location is required for attendance check-in/check-out",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#6B2FA0",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Skandan Portal to access your photos for sharing in chat"
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Camera is required for face verification during attendance",
          "enableCodeScanner": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "fcead573-caa9-437e-bd9a-7f3dce198fb9"
      }
    },
    "owner": "ybsaiprasad"
  }
}
