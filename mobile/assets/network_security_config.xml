<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config: Cleartext traffic is permitted for internal/preview networking -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Specific local development and production endpoints -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.1.13</domain>
        <domain includeSubdomains="true">192.168.29.150</domain>
        <domain includeSubdomains="true">192.168.1.104</domain>
        <domain includeSubdomains="true">skandanhomecarre.com</domain>
        <domain includeSubdomains="true">api.skandanhomecarre.com</domain>
    </domain-config>
</network-security-config>
